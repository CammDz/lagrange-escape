{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "lagrange-escape-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "REGISTRY", "class_name": "Registry" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "Registry"] },
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:5180",
    "ENVIRONMENT": "development",
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "lagrange-escape-api",
      "vars": {
        "APP_ORIGIN": "https://lagrange-escape.pages.dev",
        "ENVIRONMENT": "production",
      },
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "GameRoom" },
          { "name": "REGISTRY", "class_name": "Registry" },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GameRoom", "Registry"] },
      ],
    },
  },
}
